#!/bin/bash
#SBATCH --job-name=poisson1
#SBATCH --output=poisson48_%j.out
#SBATCH --error=poisson48_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=48
#SBATCH --time=00:30:00

module purge
module load openmpi

cd $SLURM_SUBMIT_DIR

mpiexec -n 48 ./poisson-mpi-opt --test 2 --Nx 96 --Ny 96 --Nz 96 --Px 4 --Py 4 --Pz 3